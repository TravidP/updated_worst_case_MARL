# Ignore large simulation data and logs
*.out
*.tfevents.*
*.meta
*.ckpt
*.pth

# Ignore Python cache
__pycache__/
*.py[cod]

# Integrated experiment artifacts; retain directory guides and prepared inputs.
**/revised/**/checkpoint_*/
**/revised/**/runtime/
**/revised/**/demand_runtime/
**/revised/**/artifacts/
**/revised/**/pilot_*/
**/revised/**/publication_*/
runs_eval/revised/verification/*/
runs_eval/revised/jobs/*/
docs/site/.local/

# Frozen monitoring realizations and local parent-campaign console records.
runs_eval/revised/monitoring_inputs/
output_result/revised/parent_campaign_*/

# Local generated output; explicit retained sources/configuration.
/output/
/output_adversary/**
/output_adversary_monaco/**
/output_coevolution/**
/output_coevolution_real/**
/output_result/**
/runs/**
/runs_eval/**
!/output_adversary/**/
!/output_adversary_monaco/**/
!/output_coevolution/**/
!/output_coevolution_real/**/
!/output_result/**/
!/runs/**/
!/runs_eval/**/
!/output_adversary/revised/README.md
!/output_adversary_monaco/revised/README.md
!/output_coevolution/revised/README.md
!/output_coevolution_real/revised/README.md
!/output_result/revised/README.md
!/runs/revised/README.md
!/runs_eval/revised/README.md
!/output_result/revised/tensorboard_monitor.py
!/runs/*/data/*.ini
!/runs_eval/revised/selections/*.json
/docs/history/
/.codex
/.ipynb_checkpoints/
/paper/
/docs/evaluation_workbook/grid_results_site/packages/*.zip
/docs/evaluation_workbook/grid_results_site/dist/data/series/
/docs/evaluation_workbook/grid_results_site/dist/data/rollout_metrics.csv
/docs/evaluation_workbook/grid_results_site/dist/data/networks/*/series/
/docs/evaluation_workbook/grid_results_site/dist/data/networks/*/rollout_metrics.csv
